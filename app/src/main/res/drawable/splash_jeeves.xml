<!-- Jeeves splash mark = the ACTUAL launcher icon, animated: the exact
     #14181F tuxedo paths from ic_launcher_foreground.xml on the icon's
     #FFFFFF tile. Every tuxedo piece starts hidden; splash_jeeves_animated
     brings the icon's white tile in, then dresses it — lapels, bow tie,
     buttons — so the splash resolves into the real app icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The white icon tile (ic_launcher_background) -->
    <group android:name="tile_group" android:pivotX="54" android:pivotY="54">
        <path
            android:name="tile"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0"
            android:pathData="M32,4 L76,4 A28,28 0 0 1 104,32 L104,76 A28,28 0 0 1 76,104 L32,104 A28,28 0 0 1 4,76 L4,32 A28,28 0 0 1 32,4 Z" />
    </group>

    <!-- Left jacket lapel (exact launcher path), swings on from the shoulder -->
    <group android:name="jacket_left" android:pivotX="35" android:pivotY="31">
        <path
            android:name="jacket_left_path"
            android:fillColor="#14181F"
            android:fillAlpha="0"
            android:pathData="M 38,31 L 32,30 A 33,33 0 0 0 54,88 Z" />
    </group>

    <!-- Right jacket lapel -->
    <group android:name="jacket_right" android:pivotX="73" android:pivotY="31">
        <path
            android:name="jacket_right_path"
            android:fillColor="#14181F"
            android:fillAlpha="0"
            android:pathData="M 70,31 L 76,30 A 33,33 0 0 1 54,88 Z" />
    </group>

    <!-- Bow tie: knot + two wings that snap out from centre -->
    <group android:name="bowtie_left" android:pivotX="52" android:pivotY="29">
        <path
            android:name="bowtie_left_path"
            android:fillColor="#14181F"
            android:fillAlpha="0"
            android:pathData="M 44,23 L 44,35 L 52,32 L 52,26 Z" />
    </group>
    <group android:name="bowtie_right" android:pivotX="56" android:pivotY="29">
        <path
            android:name="bowtie_right_path"
            android:fillColor="#14181F"
            android:fillAlpha="0"
            android:pathData="M 64,23 L 64,35 L 56,32 L 56,26 Z" />
    </group>
    <path
        android:name="bowtie_knot"
        android:fillColor="#14181F"
        android:fillAlpha="0"
        android:pathData="M 52,26 L 56,26 L 56,32 L 52,32 Z" />

    <!-- Three buttons (exact launcher positions), fasten top-to-bottom -->
    <path
        android:name="btn1"
        android:fillColor="#14181F"
        android:fillAlpha="0"
        android:pathData="M 51.4,52 A 2.6,2.6 0 1 1 56.6,52 A 2.6,2.6 0 1 1 51.4,52 Z" />
    <path
        android:name="btn2"
        android:fillColor="#14181F"
        android:fillAlpha="0"
        android:pathData="M 51.4,62 A 2.6,2.6 0 1 1 56.6,62 A 2.6,2.6 0 1 1 51.4,62 Z" />
    <path
        android:name="btn3"
        android:fillColor="#14181F"
        android:fillAlpha="0"
        android:pathData="M 51.4,72 A 2.6,2.6 0 1 1 56.6,72 A 2.6,2.6 0 1 1 51.4,72 Z" />
</vector>
