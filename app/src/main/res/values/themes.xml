<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme — Compose owns the actual Material3 theming; this just sets the window
         background and a parent that disables the ActionBar. -->
    <style name="Theme.HermesAgent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/hermes_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.HermesAgent.Transparent" parent="Theme.HermesAgent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- Animated splash: a crisp vector diamond that spins/scales in on black,
         replacing the low-res raster launcher icon the system splash upscales
         on large tablet screens. Applied to MainActivity; hands off to
         Theme.HermesAgent once the app draws. -->
    <style name="Theme.HermesAgent.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/midnight_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_jeeves_animated</item>
        <item name="windowSplashScreenAnimationDuration">1520</item>
        <item name="postSplashScreenTheme">@style/Theme.HermesAgent</item>
    </style>
</resources>
